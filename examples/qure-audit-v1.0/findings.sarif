                }
              }
            }
          ],
          "properties": {
            "confidence": 0.8,
            "lens": "code_quality",
            "severity": "P2",
            "why_it_matters": "Unused imports add noise and can mislead readers into thinking ModelCall is used in audit serialization logic.",
            "verifier_note": "Low-severity hygiene issue with explicit evidence; uncertainty about hidden usage is acknowledged but P2 is appropriate."
          }
        }
