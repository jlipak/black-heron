        {
          "ruleId": "BH/code_quality/P2",
          "level": "note",
          "message": {
            "text": "nextAuditId silently swallows the readdir error with a comment '// ignore \u2014 dir didn't exist', but mkdir with recursive:true is called just before it, meaning readdir failure after a successful mkdir indicates a real filesystem error that is masked."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "poc/qure_compliance/src/audit/serializer.ts"
                },
                "region": {
                  "startLine": 77
                }
              }
            }
          ],
          "properties": {
            "confidence": 0.85,
            "lens": "code_quality",
            "severity": "P2",
            "why_it_matters": "If readdir fails for any reason other than ENOENT (e.g. permission denied after mkdir), the function silently proceeds with an empty list and generates audit ID -001, potentially overwriting an existing audit file when the subsequent writeAuditJson is called.",
            "verifier_note": "Real issue but consequence (overwrite) requires writeAuditJson behavior we cannot confirm; downgrading to P2 as defensive coding concern rather than confirmed data-loss bug."
          }
        },
        {
          "ruleId": "BH/code_quality/P2",
          "level": "note",
          "message": {
            "text": "ModelCall and Trace are imported from '../types.js' but ModelCall is never referenced in the file body."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "poc/qure_compliance/src/audit/serializer.ts"
                },
                "region": {
