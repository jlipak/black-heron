{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash scripts/hooks/block-git-push.sh"},
          {"type": "command", "command": "bash scripts/hooks/block-catastrophic.sh"}
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "bash scripts/hooks/scan-secrets.sh"}
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "bash scripts/hooks/pre-compact-flush.sh"}
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "bash scripts/hooks/uncommitted-warning.sh"}
        ]
      }
    ]
  }
}
